{
  "name": "jekyll-imgflow",
  "displayName": "Jekyll ImgFlow",
  "description": "Autocomplete for jekyll-imgflow images and jekyll-documents references",
  "version": "0.2.2",
  "publisher": "gundestrup",
  "license": "AGPL-3.0-or-later",
  "icon": "images/icon.png",
  "homepage": "https://open-vsx.org/extension/gundestrup/jekyll-imgflow",
  "repository": {
    "type": "git",
    "url": "https://github.com/gundestrup/jekyll-imgflow-vscode"
  },
  "bugs": {
    "url": "https://github.com/gundestrup/jekyll-imgflow-vscode/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "jekyll",
    "imgflow",
    "documents",
    "liquid",
    "images",
    "autocomplete"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:markdown",
    "onLanguage:liquid",
    "workspaceContains:**/_config.yml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Jekyll ImgFlow",
      "properties": {
        "jekyllImgFlow.originals": {
          "type": [
            "string",
            "array"
          ],
          "default": null,
          "description": "Path (or array of paths) to the image originals directory. Auto-detected from _config.yml when unset."
        },
        "jekyllImgFlow.formats": {
          "type": "array",
          "default": [
            "jpg",
            "jpeg",
            "png",
            "gif",
            "webp",
            "avif",
            "tiff",
            "svg"
          ],
          "description": "File extensions to include in image completions"
        }
      }
    },
    "languages": [
      {
        "id": "liquid",
        "extensions": [
          ".liquid"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "npm run compile && npm run lint:tests && npm run lint:eslint",
    "lint:types": "tsc --noEmit && npm run lint:tests",
    "lint:tests": "tsc -p test/tsconfig.json",
    "lint:eslint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run compile && tsc -p tsconfig.test.json && node out/test/run-integration.js",
    "test:integration:coverage": "npm run compile && tsc -p tsconfig.test.json && COVERAGE=1 node out/test/run-integration.js && c8 report --temp-directory coverage/tmp-v8 --all --src src --exclude-after-remap --exclude 'test/**' --reporter=cobertura --reporter=text --report-dir coverage/integration",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run test && npm run audit",
    "prepare:vsix-readme": "node scripts/prepare-vsix-readme.mjs",
    "package": "npm run prepare:vsix-readme && vsce package --readme-path .vsix-readme/README.md",
    "semgrep": "semgrep ci --dry-run",
    "semgrep:local": "semgrep scan --config .semgrep.yml --error src/",
    "semgrep:publish": "semgrep publish .semgrep.yml"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.x",
    "@types/vscode": "1.91.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "js-yaml": "^5.4.2",
    "mocha": "^11.7.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "serialize-javascript": "^7.1.0",
    "diff": "^9.0.0",
    "qs": "^6.16.0"
  }
}
